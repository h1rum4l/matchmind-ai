{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "matchmind/api.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,frontend/node_modules/**,frontend/src/**,frontend/tests/**,tests/**,backups/**,.git/**,.venv/**,venv/**,.pytest_cache/**,.ruff_cache/**,data/raw/**,data/la-liga/raw/**,assets/**,app.py,index.html,.streamlit/**}"
    }
  }
}
